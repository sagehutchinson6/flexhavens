# ── Backend ─────────────────────────────────────────────────────
APP_ID=local              # Application ID ("local" is fine for local dev)
APP_SECRET=               # Application secret (used for JWT signing) — any long random string

# ── Database ───────────────────────────────────────────────────
# This project uses its own dedicated database named: flexinvest_db
# Format: mysql://user:pass@host:port/flexinvest_db
DATABASE_URL=mysql://root:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/flexinvest_db

# ── Frontend (exposed to browser via Vite) ──────────────────────
# OAuth is not used for local dev (admin uses password login, investors use
# their own JWT) — but these must be valid URLs or the dev server won't boot.
VITE_KIMI_AUTH_URL=https://auth.kimi.com
VITE_APP_ID=local

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=https://auth.kimi.com
KIMI_OPEN_URL=https://open.kimi.com

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── Storefront Admin Portal (/admin) ────────────────────────────
ADMIN_PASSWORD=           # Password for the storefront admin dashboard (default: admin123)

# ── Investment Portal ───────────────────────────────────────────
INVESTOR_JWT_SECRET=      # Optional separate secret for investor session JWTs (falls back to APP_SECRET)

# ── Email (optional — enables real email delivery) ─────────────
# Without these, verification/reset links are shown in the app (dev mode).
SMTP_HOST=                  # e.g. smtp.gmail.com, smtp.office365.com
SMTP_PORT=587               # 587 (STARTTLS) or 465 (SSL)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=                  # sender address, e.g. no-reply@yourdomain.com

# Public URL of the site — used to build links inside emails
APP_URL=http://localhost:5173
